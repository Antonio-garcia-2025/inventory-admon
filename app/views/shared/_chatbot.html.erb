<style>
  #chatbot-flotante {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 320px;
    background-color: white;
    border-radius: 12px;
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.2);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.3s ease;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  #chatbot-flotante.chat-minimizado .chat-body,
  #chatbot-flotante.chat-minimizado .chat-footer {
    display: none;
  }

  #chatbot-flotante.chat-minimizado {
    width: 190px;
  }

  #chatbot-flotante.chat-minimizado .chat-header {
    padding: 8px 10px;
  }

  #chatbot-flotante.chat-minimizado .chat-header h4 {
    font-size: 14px;
  }

  #chatbot-flotante.chat-minimizado .btn-minimizar {
    font-size: 18px;
  }

  .chat-header {
    background-color: #0d6efd;
    color: white;
    padding: 12px 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .chat-header h4 { margin: 0; font-size: 16px; font-weight: 600; }

  .btn-minimizar {
    background: none;
    border: none;
    color: white;
    font-size: 22px;
    font-weight: bold;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  .chat-body {
    padding: 15px;
    height: 300px;
    overflow-y: auto;
    background-color: #f8f9fa;
    scroll-behavior: smooth;
  }

  .mensaje-ia,
  .mensaje-usuario {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    margin-bottom: 8px;
    width: fit-content;
    max-width: 85%;
  }

  .mensaje-ia {
    background-color: #e2f0fd;
    color: #084298;
  }

  .mensaje-usuario {
    background-color: #d1e7dd;
    color: #0f5132;
    margin-left: auto;
  }

  .chat-footer {
    padding: 10px;
    background-color: white;
    border-top: 1px solid #ddd;
    display: flex;
    gap: 8px;
  }

  .chat-footer input[type="text"] {
    flex-grow: 1;
    padding: 8px 12px;
    border: 1px solid #ccc;
    border-radius: 20px;
    outline: none;
    font-size: 14px;
  }

  .btn-enviar-chat {
    background-color: #198754;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
  }

  .btn-enviar-chat:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .escribiendo {
    font-style: italic;
    color: #6c757d;
    background-color: #e9ecef;
    animation: parpadeo 1.5s infinite;
  }

  @keyframes parpadeo {
    0% { opacity: 0.4; }
    50% { opacity: 1; }
    100% { opacity: 0.4; }
  }
</style>

<div id="chatbot-flotante" class="chat-minimizado">
  <div class="chat-header" id="header-chat">
    <h4>🤖 Soporte</h4>
    <button class="btn-minimizar" id="btn-minimizar-chat" type="button" aria-label="Abrir chat" aria-expanded="false">＋</button>
  </div>

  <div class="chat-body" id="chat-mensajes" aria-live="polite">
    <div class="mensaje-ia"><strong>MercadoBot:</strong> ¡Hola! ¿En qué te ayudo hoy?</div>
  </div>

  <div class="chat-footer">
    <input type="text" id="input-chat" placeholder="Escribe tu pregunta..." autocomplete="off">
    <button class="btn-enviar-chat" id="btn-enviar-chat" type="button">Enviar</button>
  </div>
</div>
