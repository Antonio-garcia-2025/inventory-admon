<div style="display: flex; flex-direction: column; gap: 24px;">

  <!-- BANNER DE BIENVENIDA -->
  <div class="store-banner">
    <div>
      <h1>🛍️ Mercado Global</h1>
      <p style="margin: 0; font-size: 0.95em; opacity: 0.9;">Descubre y compra productos directamente de vendedores independientes.</p>
    </div>
    <div>
      <% if user_signed_in? %>
        <%= link_to "📦 Mi Inventario", products_path, style: "background-color: white; color: #1a73e8; text-decoration: none; padding: 10px 18px; border-radius: 8px; font-weight: bold; font-size: 0.9em; display: inline-block;" %>
      <% else %>
        <%= link_to "🚀 Conviértete en Vendedor", new_user_registration_path, style: "background-color: #34a853; color: white; text-decoration: none; padding: 10px 18px; border-radius: 8px; font-weight: bold; font-size: 0.9em; display: inline-block;" %>
      <% end %>
    </div>
  </div>

  <!-- BUSCADOR Y FILTROS -->
  <div style="display: flex; flex-direction: column; gap: 14px;">
    
    <!-- FORMULARIO DE BÚSQUEDA RESPONSIVO -->
    <%= form_with url: store_path, method: :get, local: true, class: "search-form" do |f| %>
      <% if params[:category_id].present? %>
        <%= f.hidden_field :category_id, value: params[:category_id] %>
      <% end %>

      <%= f.text_field :query, value: params[:query], placeholder: "🔍 Buscar productos...", class: "search-input" %>
      <div style="display: flex; gap: 8px;">
        <%= f.submit "Buscar", class: "btn-dark", style: "flex: 1;" %>
        <% if params[:query].present? || params[:category_id].present? %>
          <%= link_to "Limpiar", store_path, style: "padding: 10px; color: #d93025; text-decoration: none; font-size: 0.85em; font-weight: bold; display: flex; align-items: center;" %>
        <% end %>
      </div>
    <% end %>

    <!-- FILTROS POR CATEGORÍA -->
    <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
      <span style="font-weight: bold; color: #5f6368; font-size: 0.85em;">Categorías:</span>
      <%= link_to "Todos", store_path(query: params[:query]), style: "text-decoration: none; padding: 5px 12px; border-radius: 16px; font-size: 0.8em; font-weight: 600; #{params[:category_id].blank? ? 'background-color: #202124; color: white;' : 'background-color: white; color: #3c4043; border: 1px solid #dadce0;'}" %>
      
      <% @categories.each do |category| %>
        <%= link_to category.name, store_path(category_id: category.id, query: params[:query]), style: "text-decoration: none; padding: 5px 12px; border-radius: 16px; font-size: 0.8em; font-weight: 600; #{params[:category_id].to_s == category.id.to_s ? 'background-color: #1a73e8; color: white;' : 'background-color: white; color: #3c4043; border: 1px solid #dadce0;'}" %>
      <% end %>
    </div>

  </div>

  <!-- GRILLA RESPONSIVA -->
  <% if @products.any? %>
    <div class="products-grid">
      <% @products.each do |product| %>
        <div class="product-card">
          
          <!-- CONTENEDOR DE IMAGEN -->
          <div class="product-image-box">
            <%= link_to product_path(product), style: "display: block; width: 100%; height: 100%; text-decoration: none; display: flex; align-items: center; justify-content: center;" do %>
              <% if product.image.attached? %>
                <%= image_tag product.image %>
              <% else %>
                <div style="color: #9aa0a6; font-size: 2.2em;">📦</div>
              <% end %>
            <% end %>
          </div>

          <!-- DETALLES PRINCIPALES -->
          <div style="padding: 14px 14px 8px 14px; display: flex; flex-direction: column; gap: 6px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="background-color: #e8f0fe; color: #1a73e8; padding: 2px 8px; border-radius: 10px; font-size: 0.72em; font-weight: bold; text-transform: uppercase;">
                <%= product.category&.name || "General" %>
              </span>
              <span style="color: #137333; font-size: 0.75em; font-weight: bold;">
                ● <%= product.stock %> disp.
              </span>
            </div>

            <h3 style="margin: 0; font-size: 1.05em;">
              <%= link_to product.name, product_path(product), style: "color: #202124; text-decoration: none; font-weight: 700;" %>
            </h3>

            <!-- ESTRELLAS Y TOTAL DE OPINIONES -->
            <div style="display: flex; align-items: center; gap: 6px; font-size: 0.85em;">
              <span style="color: #f2994a; font-size: 1.05em;"><%= product.star_rating %></span>
              <span style="color: #5f6368; font-size: 0.85em;">(<%= product.reviews.count %>)</span>
            </div>

            <!-- RESEÑA DESTACADA / SNIPPET -->
            <% latest_review = product.reviews.last %>
            <% if latest_review %>
              <div style="background-color: #f8f9fa; border-left: 3px solid #1a73e8; padding: 6px 10px; border-radius: 0 6px 6px 0; margin-top: 4px;">
                <p style="margin: 0; font-size: 0.78em; color: #3c4043; font-style: italic; line-height: 1.3;">
                  "<%= truncate(latest_review.comment, length: 55) %>"
                </p>
                <span style="font-size: 0.7em; color: #80868b; display: block; margin-top: 2px;">
                  — @<%= latest_review.user&.display_name %>
                </span>
              </div>
            <% else %>
              <div style="margin-top: 4px;">
                <%= link_to "Sé el primero en calificar", product_path(product), style: "color: #1a73e8; font-size: 0.75em; text-decoration: none;" %>
              </div>
            <% end %>
            
            <div style="font-size: 0.8em; color: #5f6368; margin-top: 4px;">
              <span>👤 @<%= product.user&.display_name || "Tienda" %></span>
            </div>
          </div>

          <!-- PRECIO Y ACCIÓN -->
          <div style="padding: 12px 14px; background-color: #f8f9fa; border-top: 1px solid #f1f3f4; display: flex; justify-content: space-between; align-items: center; gap: 8px;">
            <div>
              <span style="font-size: 0.68em; color: #5f6368; text-transform: uppercase; display: block;">Precio</span>
              <span style="font-size: 1.15em; font-weight: 800; color: #202124;"><%= number_to_currency(product.price) %></span>
            </div>

            <div>
              <% if user_signed_in? && product.user == current_user %>
                <span style="background-color: #f1f3f4; color: #5f6368; border: 1px solid #dadce0; padding: 6px 10px; border-radius: 6px; font-size: 0.75em; font-weight: bold;">Tu Producto</span>
              <% else %>
                <%= button_to "🛒 Agregar", add_to_cart_path(product_id: product.id), method: :post, style: "background-color: #1a73e8; color: white; border: none; padding: 8px 12px; border-radius: 6px; font-weight: bold; font-size: 0.85em; cursor: pointer;" %>
              <% end %>
            </div>
          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <div style="background: white; border: 1px dashed #dadce0; border-radius: 12px; padding: 40px 16px; text-align: center;">
      <h3 style="color: #3c4043; margin-bottom: 8px;">No se encontraron productos</h3>
      <p style="color: #70757a; margin-bottom: 16px; font-size: 0.9em;">Prueba con otro término de búsqueda o categoría.</p>
      <%= link_to "Ver todos los productos", store_path, class: "btn-primary" %>
    </div>
  <% end %>

</div>