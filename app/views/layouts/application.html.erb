<!DOCTYPE html>
<html>
  <head>
    <title>Mercado Shop</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    
    <!-- BARRA DE NAVEGACIÓN RESPONSIVA -->
    <header class="navbar">
      
      <!-- LOGO Y NAVEGACIÓN -->
      <div class="navbar-brand-group">
        <%= link_to "🛍️ Mercado Shop", root_path, style: "color: white; font-weight: 800; text-decoration: none; font-size: 1.15em;" %>
        <%= link_to "🏪 Ver Tienda", store_path, class: "nav-link" %>
        <% if user_signed_in? %>
          <%= link_to "🛍️ Mis Compras", orders_path, class: "nav-link" %>
        <% end %>
        <% if user_signed_in? %>
          <%= link_to "📦 Mi Inventario", products_path, class: "nav-link" %>
        <% end %>
      </div>

      <!-- ACCIONES Y USUARIO -->
      <div class="navbar-actions">
        <% if user_signed_in? %>
          
          <!-- CARRITO -->
          <%= link_to cart_path, class: "nav-badge-cart" do %>
            <span>🛒</span>
            <span><%= current_cart&.total_items_count || 0 %></span>
          <% end %>

          <span style="color: #8ab4f8; font-weight: 600; font-size: 0.85em;">@<%= current_user.display_name %></span>
          
          <% if (current_user.respond_to?(:admin?) && current_user.admin?) || current_user.email.to_s.downcase == "antonioggguerrero@gmail.com" %>
            <%= link_to "🛡️ Admin", admin_dashboard_path, style: "background-color: #f2994a; color: white; text-decoration: none; padding: 5px 10px; border-radius: 4px; font-weight: bold; font-size: 0.8em;" %>
          <% end %>

          <%= button_to "Salir", destroy_user_session_path, method: :delete, style: "background: none; border: 1px solid #5f6368; color: #dadce0; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 0.8em;" %>
        <% else %>
          <%= link_to "Iniciar sesión", new_user_session_path, class: "nav-link" %>
          <%= link_to "Registrarse", new_user_registration_path, class: "btn-primary", style: "padding: 6px 12px; font-size: 0.85em;" %>
        <% end %>
      </div>

    </header>

    <!-- MENSAJES FLASH -->
    <% if notice %>
      <div style="background-color: #e6f4ea; color: #137333; padding: 10px 16px; border-bottom: 1px solid #ceead6; text-align: center; font-size: 0.9em; font-weight: 500;">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div style="background-color: #fce8e6; color: #c5221f; padding: 10px 16px; border-bottom: 1px solid #fad2cf; text-align: center; font-size: 0.9em; font-weight: 500;">
        <%= alert %>
      </div>
    <% end %>

    <!-- CONTENEDOR PRINCIPAL FLUIDO -->
    <main class="app-container">
      <%= yield %>
    </main>

    <!-- Burbuja Flotante de Telegram -->
    <a href="https://t.me/inventario_admon_bot" target="_blank" class="telegram-float" title="Consultar Inventario en Telegram">
      <!-- Icono SVG de Telegram -->
      <svg viewBox="0 0 24 24" width="35" height="35" fill="white">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.04-1.96 1.25-5.54 3.69-.52.36-1 .53-1.42.52-.47-.01-1.37-.26-2.03-.48-.82-.27-1.47-.42-1.42-.88.03-.24.38-.48 1.07-.74 4.2-1.82 7-3.02 8.4-3.61 4-.1.69 4.86 1.07 4.99 1.48z"/>
      </svg>
    </a>

    <style>
      .telegram-float {
        position: fixed;
        width: 60px;
        height: 60px;
        bottom: 40px;
        right: 40px;
        background-color: #0088cc;
        color: #FFF;
        border-radius: 50px;
        text-align: center;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        transition: transform 0.3s ease, background-color 0.3s ease;
      }
      
      .telegram-float:hover {
        transform: scale(1.1);
        background-color: #0077b3;
        box-shadow: 0px 6px 14px rgba(0,0,0,0.4);
      }
    </style>

  </body>
</html>