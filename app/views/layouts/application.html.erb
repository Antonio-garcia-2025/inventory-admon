<!DOCTYPE html>
<html>
  <head>
    <title>Mercado Shop</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    
    <!-- BARRA DE NAVEGACIÓN RESPONSIVA -->
    <header class="navbar">
      
      <!-- LOGO Y NAVEGACIÓN -->
      <div class="navbar-brand-group">
        <%= link_to "🛍️ Mercado Shop", root_path, style: "color: white; font-weight: 800; text-decoration: none; font-size: 1.15em;" %>
        <%= link_to "🏪 Ver Tienda", store_path, class: "nav-link" %>
        <% if user_signed_in? %>
          <%= link_to "🛍️ Mis Compras", orders_path, class: "nav-link" %>
        <% end %>
        <% if user_signed_in? %>
          <%= link_to "📦 Mi Inventario", products_path, class: "nav-link" %>
        <% end %>
      </div>

      <!-- ACCIONES Y USUARIO -->
      <div class="navbar-actions">
        <% if user_signed_in? %>
          
          <!-- CARRITO -->
          <%= link_to cart_path, class: "nav-badge-cart" do %>
            <span>🛒</span>
            <span><%= current_cart&.total_items_count || 0 %></span>
          <% end %>

          <span style="color: #8ab4f8; font-weight: 600; font-size: 0.85em;">@<%= current_user.display_name %></span>
          
          <% if (current_user.respond_to?(:admin?) && current_user.admin?) || current_user.email.to_s.downcase == "antonioggguerrero@gmail.com" %>
            <%= link_to "🛡️ Admin", admin_dashboard_path, style: "background-color: #f2994a; color: white; text-decoration: none; padding: 5px 10px; border-radius: 4px; font-weight: bold; font-size: 0.8em;" %>
          <% end %>

          <%= button_to "Salir", destroy_user_session_path, method: :delete, style: "background: none; border: 1px solid #5f6368; color: #dadce0; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 0.8em;" %>
        <% else %>
          <%= link_to "Iniciar sesión", new_user_session_path, class: "nav-link" %>
          <%= link_to "Registrarse", new_user_registration_path, class: "btn-primary", style: "padding: 6px 12px; font-size: 0.85em;" %>
        <% end %>
      </div>

    </header>

    <!-- MENSAJES FLASH -->
    <% if notice %>
      <div style="background-color: #e6f4ea; color: #137333; padding: 10px 16px; border-bottom: 1px solid #ceead6; text-align: center; font-size: 0.9em; font-weight: 500;">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div style="background-color: #fce8e6; color: #c5221f; padding: 10px 16px; border-bottom: 1px solid #fad2cf; text-align: center; font-size: 0.9em; font-weight: 500;">
        <%= alert %>
      </div>
    <% end %>

    <!-- CONTENEDOR PRINCIPAL FLUIDO -->
    <main class="app-container">
      <%= yield %>
    </main>

  </body>
</html>