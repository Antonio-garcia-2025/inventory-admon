<div style="max-width: 1100px; margin: 0 auto;">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
    <div>
      <h1 style="margin: 0; color: #202124;">🛡️ Panel Privado de Administración</h1>
      <p style="margin: 5px 0 0 0; color: #5f6368;">Métricas globales y gestión de cuentas</p>
    </div>
    <%= link_to "⬅ Volver a mi Inventario", root_path, style: "background-color: #f1f3f4; color: #202124; text-decoration: none; padding: 9px 15px; border-radius: 6px; font-weight: bold; border: 1px solid #dadce0;" %>
  </div>

  <!-- TARJETAS DE MÉTRICAS -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-bottom: 30px;">
    <div style="padding: 18px; background-color: #fef7e0; border: 1px solid #feefc3; border-radius: 8px;">
      <span style="font-size: 0.85em; color: #b06000; font-weight: bold; text-transform: uppercase;">👥 Vendedores Registrados</span>
      <h2 style="margin: 8px 0 0 0; color: #b06000;"><%= @total_sellers_count %></h2>
    </div>

    <div style="padding: 18px; background-color: #f3e8fd; border: 1px solid #e9d2fd; border-radius: 8px;">
      <span style="font-size: 0.85em; color: #8430ce; font-weight: bold; text-transform: uppercase;">📦 Total Productos</span>
      <h2 style="margin: 8px 0 0 0; color: #8430ce;"><%= @total_products_count %></h2>
    </div>

    <div style="padding: 18px; background-color: #e8f0fe; border: 1px solid #d2e3fc; border-radius: 8px;">
      <span style="font-size: 0.85em; color: #1a73e8; font-weight: bold; text-transform: uppercase;">📊 Unidades en Stock Global</span>
      <h2 style="margin: 8px 0 0 0; color: #1a73e8;"><%= @total_inventory_stock %> unidades</h2>
    </div>
  </div>

  <!-- TABLA DE VENDEDORES -->
  <h3 style="margin-bottom: 12px; color: #202124;">Cuentas de Vendedores</h3>
  <table border="1" cellpadding="10" style="border-collapse: collapse; width: 100%; border: 1px solid #e0e0e0; text-align: left; background-color: white;">
    <thead>
      <tr style="background-color: #202124; color: white;">
        <th>Vendedor (Email)</th>
        <th>Fecha Registro</th>
        <th style="text-align: center;">Productos Creados</th>
        <th style="text-align: center;">Stock Disponible</th>
        <th style="text-align: center;">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% @sellers.each do |seller| %>
        <tr style="border-bottom: 1px solid #eee;">
          <td>
            <strong><%= seller[:email] %></strong>
            <% if seller[:email] == current_user.email %>
              <span style="background-color: #008060; color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.75em; margin-left: 6px;">Tú (Admin)</span>
            <% end %>
          </td>
          <td style="color: #5f6368; font-size: 0.9em;"><%= seller[:created_at].strftime("%d/%m/%Y") %></td>
          <td style="text-align: center;"><%= seller[:products_count] %></td>
          <td style="text-align: center;"><%= seller[:total_stock] %> unidades</td>
          <td style="text-align: center;">
            <% if seller[:email] != current_user.email %>
              <%= button_to "Eliminar cuenta", admin_destroy_user_path(seller[:id]), method: :delete, data: { turbo_confirm: "¿Estás seguro de eliminar a #{seller[:email]}?" }, style: "background-color: #d93025; color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 0.85em; font-weight: bold; cursor: pointer;" %>
            <% else %>
              <span style="color: #80868b; font-size: 0.85em; font-style: italic;">Inmune</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>