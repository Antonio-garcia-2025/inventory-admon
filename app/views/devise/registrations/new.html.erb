<div style="max-width: 450px; margin: 40px auto; background: white; padding: 30px; border-radius: 8px; border: 1px solid #dadce0; box-shadow: 0 2px 6px rgba(0,0,0,0.05);">
  <h2 style="margin-top: 0; color: #202124; text-align: center;">Crear Cuenta de Vendedor</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <!-- CAMPO USERNAME -->
    <div style="margin-bottom: 15px;">
      <%= f.label :username, "Nombre de Usuario o Tienda:", style: "display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.9em;" %>
      <%= f.text_field :username, autofocus: true, placeholder: "Ej. MiTiendaCDMX", required: true, style: "width: 100%; padding: 10px; border: 1px solid #dadce0; border-radius: 6px; box-sizing: border-box;" %>
      <small style="color: #5f6368; font-size: 0.8em;">Este nombre público se mostrará a tus compradores.</small>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :email, "Correo Electrónico (Privado):", style: "display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.9em;" %>
      <%= f.email_field :email, autocomplete: "email", required: true, style: "width: 100%; padding: 10px; border: 1px solid #dadce0; border-radius: 6px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password, "Contraseña:", style: "display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.9em;" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true, style: "width: 100%; padding: 10px; border: 1px solid #dadce0; border-radius: 6px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= f.label :password_confirmation, "Confirmar Contraseña:", style: "display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.9em;" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, style: "width: 100%; padding: 10px; border: 1px solid #dadce0; border-radius: 6px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.submit "Registrarse", style: "width: 100%; background-color: #1a73e8; color: white; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 1em;" %>
    </div>
  <% end %>

  <div style="text-align: center; font-size: 0.9em;">
    <%= render "devise/shared/links" %>
  </div>
</div>