<div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px;">

  <!-- ENCABEZADO -->
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
    <h1 style="margin: 0; color: #202124; font-size: 1.5em; font-weight: 800;">🛒 Mi Carrito</h1>
    <%= link_to "⬅ Seguir Comprando", store_path, style: "color: #1a73e8; text-decoration: none; font-weight: 600; font-size: 0.9em;" %>
  </div>

  <% if @cart_items.any? %>
    
    <div class="cart-items-container">
      
      <!-- ENCABEZADO DE TABLA (VISIBLE SOLO EN ESCRITORIO) -->
      <div class="cart-table-header">
        <span>Producto</span>
        <span>Vendedor</span>
        <span style="text-align: center;">Cant.</span>
        <span style="text-align: right;">Precio</span>
        <span style="text-align: right;">Subtotal</span>
        <span style="text-align: center;">Acción</span>
      </div>

      <!-- LISTA DE PRODUCTOS (TARJETAS EN CELULAR, FILAS EN PC) -->
      <% @cart_items.each do |item| %>
        <div class="cart-card-item">
          
          <!-- PRODUCTO: FOTO Y NOMBRE -->
          <div class="cart-card-top">
            <div class="cart-card-thumb">
              <% if item.product.image.attached? %>
                <%= image_tag item.product.image, style: "width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" %>
              <% else %>
                <span style="font-size: 1.4em;">📦</span>
              <% end %>
            </div>
            <div class="cart-card-info">
              <h4><%= item.product.name %></h4>
              <p class="cart-card-seller">Vendido por: <strong>@<%= item.product.user&.display_name %></strong></p>
            </div>
          </div>

          <!-- COLUMNA ESCRITORIO: VENDEDOR -->
          <div class="cart-desktop-cell" style="color: #5f6368; font-size: 0.85em;">
            @<%= item.product.user&.display_name %>
          </div>

          <!-- COLUMNA ESCRITORIO: CANTIDAD -->
          <div class="cart-desktop-cell" style="text-align: center; font-weight: bold;">
            <%= item.quantity %>
          </div>

          <!-- COLUMNA ESCRITORIO: PRECIO UNITARIO -->
          <div class="cart-desktop-cell" style="text-align: right; color: #5f6368; font-size: 0.9em;">
            <%= number_to_currency(item.product.price) %>
          </div>

          <!-- COLUMNA ESCRITORIO: SUBTOTAL -->
          <div class="cart-desktop-cell" style="text-align: right; font-weight: bold; color: #137333; font-size: 0.95em;">
            <%= number_to_currency(item.total_price) %>
          </div>

          <!-- PARTE INFERIOR EN MÓVIL (PRECIO, CANTIDAD Y BORRAR) -->
          <div class="cart-card-bottom">
            <div class="cart-card-pricing cart-mobile-only">
              <span class="cart-card-subtotal"><%= number_to_currency(item.total_price) %></span>
              <span class="cart-card-unit"><%= item.quantity %> <%= item.quantity == 1 ? 'unidad' : 'unidades' %> × <%= number_to_currency(item.product.price) %></span>
            </div>

            <!-- BOTÓN QUITAR -->
            <div style="text-align: center;">
              <%= button_to remove_cart_item_path(item_id: item.id), method: :delete, style: "background: #fce8e6; color: #c5221f; border: none; padding: 6px 12px; border-radius: 6px; font-weight: bold; font-size: 0.8em; cursor: pointer; display: flex; align-items: center; gap: 4px;" do %>
                <span>✕</span> <span>Quitar</span>
              <% end %>
            </div>
          </div>

        </div>
      <% end %>

      <!-- RESUMEN Y BOTÓN DE PAGO -->
      <div style="padding: 20px; background-color: #f8f9fa; border-top: 1px solid #ebebeb; display: flex; flex-direction: column; gap: 14px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="color: #5f6368; font-size: 0.95em; font-weight: 500;">Total acumulado:</span>
          <h2 style="margin: 0; color: #137333; font-size: 1.6em; font-weight: 800;"><%= number_to_currency(@cart.total_price) %></h2>
        </div>

        <%= button_to "💳 Confirmar y Pagar Pedido", checkout_cart_path, method: :post, data: { turbo_confirm: "¿Deseas procesar la compra por #{number_to_currency(@cart.total_price)}?" }, style: "background-color: #008060; color: white; border: none; padding: 14px; border-radius: 8px; font-weight: bold; font-size: 1em; width: 100%; cursor: pointer; box-shadow: 0 2px 6px rgba(0,128,96,0.25);" %>
      </div>

    </div>

  <% else %>
    <div style="background: white; border: 1px dashed #dadce0; border-radius: 12px; padding: 48px 16px; text-align: center;">
      <p style="color: #5f6368; font-size: 1.05em; margin-bottom: 16px;">Tu carrito está actualmente vacío.</p>
      <%= link_to "🛍️ Explorar Productos", store_path, class: "btn-primary", style: "display: inline-block;" %>
    </div>
  <% end %>

</div>